# Supabase 프로젝트 설정
# https://app.supabase.com → 프로젝트 → Settings → API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 관리자 비밀번호 (SHA-256 해시값)
# 원하는 비밀번호를 https://emn178.github.io/online-tools/sha256.html 에서 해시 변환 후 입력
# 기본값(비워두면): admin1234
VITE_ADMIN_PASSWORD_HASH=
